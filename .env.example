NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_MID=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
NEXT_PUBLIC_OG_IMAGE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_TAG_ID=G-PG94DFHSY0
# Resend (상담 신청 시 관리자 알림 메일)
RESEND_API_KEY=
# 발신: 도메인 인증 전에는 코드에서 항상 onboarding@resend.dev 사용.
# 인증 후 아래를 true로 두고 RESEND_FROM_EMAIL에 인증된 주소를 넣으면 해당 주소로 발신.
RESEND_DOMAIN_VERIFIED=
RESEND_FROM_EMAIL=
# 수신: Resend 가입 Gmail로 통일 권장. 비어 있으면 코드에서 dpcoolm@gmail.com 사용.
# 여러 명은 쉼표·세미콜론 구분. dpcoolm@gmail.com은 항상 To 맨 앞(최우선)에 한 번 더 포함됩니다.
ADMIN_NOTIFY_EMAIL=dpcoolm@gmail.com
ADMIN_EMAIL=dpcoolm@gmail.com
# ── Google 스프레드시트 적재(웹훅) ─────────────────────────────
# 모든 제출(리드·파트너 신청·문의)을 구글 시트에 한 줄씩 저장하고,
# 파트너 신청은 Apps Script가 알림 메일까지 보낸다.
# 설정: scripts/sheets-webhook.gs를 Google Apps Script에 붙여 웹앱으로 배포 → 그 URL을 아래에.
# 비워두면 시트 적재는 자동으로 비활성(no-op) — 기존 흐름엔 영향 없음.
SHEETS_WEBHOOK_URL=
# 임의 POST 차단용 공유 비밀값(Apps Script의 TOKEN과 동일하게).
SHEETS_WEBHOOK_TOKEN=
